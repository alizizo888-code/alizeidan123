# Private desk apps: never indexed, never cached by shared caches. (A child .htaccess replaces the WordPress rewrite rules of the parent folder.)
RewriteEngine On
RewriteRule ^$ desk.html [L]
<IfModule mod_headers.c>
Header set X-Robots-Tag "noindex, nofollow, noarchive"
Header set Referrer-Policy "no-referrer"
<FilesMatch "\.(html|webmanifest)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
AddType application/vnd.android.package-archive .apk
<IfModule mod_headers.c>
<FilesMatch "\.apk$">
Header set Content-Disposition "attachment"
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
SetEnvIfNoCase Request_URI \.apk$ no-gzip
</IfModule>
DirectoryIndex desk.html
